---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Domov">

	<header class="text-center mt-8 mb-24">
		<h3 class="text-3xl md:text-4xl tracking-[0.3em] font-light text-purple-100/90 uppercase">
			Moja cesta životom
		</h3>
		<div class="h-[1px] w-48 bg-white/10 mx-auto mt-6"></div>
	</header>

	<div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 items-start">
		
		<div class="flex flex-col items-center">
			<h2 class="text-lg tracking-widest uppercase mb-4 font-bold">Ročné výklady</h2>
			<div class="w-full h-[3px] bg-red-600 shadow-[0_0_10px_rgba(220,38,38,0.5)] mb-8"></div>
			
			<div class="flex flex-col gap-6 text-xl font-light text-purple-200/80">
				<a href="/tarot/annual/2024" class="hover:text-white hover:translate-x-2 transition-all">2024</a>
				<a href="/tarot/annual/2025" class="hover:text-white hover:translate-x-2 transition-all">2025</a>
				<a href="/tarot/annual/2026" class="hover:text-white hover:translate-x-2 transition-all">2026</a>
				<a href="/tarot/annual/2027" class="hover:text-white hover:translate-x-2 transition-all">2027</a>
			</div>
		</div>

		<div class="flex flex-col items-center">
			<h2 class="text-lg tracking-widest uppercase mb-4 font-bold">Mesačné výklady</h2>
			<div class="w-full h-[3px] bg-red-600 shadow-[0_0_10px_rgba(220,38,38,0.5)] mb-8"></div>
			
			<div class="w-full space-y-4">
				<details class="group cursor-pointer">
					<summary class="list-none text-center text-xl font-light text-purple-200/80 group-hover:text-white transition">
						2025
					</summary>
					<div class="flex flex-col items-center gap-3 mt-4 py-4 bg-white/5 rounded-lg border border-white/5">
						<a href="/tarot/mesacne/2025/januar" class="text-sm tracking-widest hover:text-red-400">- JANUÁR</a>
						<a href="/tarot/mesacne/2025/februar" class="text-sm tracking-widest hover:text-red-400">- FEBRUÁR</a>
						<a href="/tarot/mesacne/2025/marec" class="text-sm tracking-widest hover:text-red-400">- MAREC</a>
					</div>
				</details>

				<details class="group cursor-pointer">
					<summary class="list-none text-center text-xl font-light text-purple-200/80 group-hover:text-white transition">2026</summary>
					<div class="flex flex-col items-center gap-3 mt-4 py-4 bg-white/5 rounded-lg border border-white/5">
						<a href="/tarot/monthly/2026/JanFeb" class="text-sm tracking-widest hover:text-red-400">JANUÁR & FEBRUÁR</a>
						<a href="/tarot/monthly/2026/MarApr" class="text-sm tracking-widest hover:text-red-400">MAREC & APRÍL</a>
					</div>
				</details>
			</div>
		</div>

		<div class="flex flex-col items-center">
			<h2 class="text-lg tracking-widest uppercase mb-4 font-bold">Ostatné výklady</h2>
			<div class="w-full h-[3px] bg-red-600 shadow-[0_0_10px_rgba(220,38,38,0.5)] mb-8"></div>
			
			<div class="w-full flex flex-col gap-4">
				<a href="/tarot/other/oraculum" class="w-full py-3 px-6 bg-white/5 border border-white/10 rounded-md text-center tracking-widest hover:bg-purple-600/20 hover:border-purple-500/50 transition-all">
					Oraculum lásky
				</a>
				<a href="/tarot/other/strawberry-full-moon" class="w-full py-3 px-6 bg-white/5 border border-white/10 rounded-md text-center tracking-widest hover:bg-purple-600/20 hover:border-purple-500/50 transition-all">
					Jahodový spln
				</a>
				<a href="/tarot/other/august-full-moon" class="w-full py-3 px-6 bg-white/5 border border-white/10 rounded-md text-center tracking-widest hover:bg-purple-600/20 hover:border-purple-500/50 transition-all">
					Augustový spln
				</a>
			</div>
		</div>

	</div>
</MainLayout>